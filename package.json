{
  "name": "universal-website-connector",
  "version": "1.0.0",
  "description": "MCP server for fetching and editing data on any website (public or login-required) via browser automation.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "universal-website-connector": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "web": "node dist/web/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.9.0",
    "express": "^5.2.1",
    "playwright": "^1.48.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.7.4",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=18"
  }
}
